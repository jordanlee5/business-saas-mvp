<import src="../../templates/mall-nav.wxml" />
<view class="category-screen mall-screen">
  <view class="search-area">
    <view class="search-field">
      <text class="search-mark">⌕</text>
      <input class="search-input" type="text" value="{{draftQuery}}" maxlength="81" placeholder="搜索当前分类的好物" confirm-type="search" bindinput="onSearchInput" bindconfirm="onSearchSubmit" />
      <text class="search-clear" wx:if="{{draftQuery || activeQuery}}" bindtap="onClearSearch" aria-label="清除搜索">清除</text>
    </view>
    <button class="search-button" bindtap="onSearchSubmit">搜索</button>
  </view>
  <text class="search-hint" wx:if="{{searchError}}">{{searchError}}</text>
  <view class="category-layout">
    <scroll-view class="category-rail" scroll-y="true" scroll-into-view="side-{{activeKey}}" show-scrollbar="false">
      <button wx:for="{{categories}}" wx:key="key" id="side-{{item.key}}" class="rail-item {{activeKey === item.key ? 'rail-active' : ''}}" data-key="{{item.key}}" bindtap="onCategoryTap" aria-label="{{activeKey === item.key ? '当前分类：' : '切换分类：'}}{{item.name}}">{{item.name}}</button>
    </scroll-view>
    <scroll-view class="category-products" scroll-y="true" scroll-top="{{scrollTop}}" bindscroll="onProductsScroll" bindscrolltolower="onLoadMore" lower-threshold="100">
      <view class="products-inner">
        <view class="products-heading"><text class="category-title">{{activeName}}</text><text class="category-caption">慢慢挑，总有喜欢的</text></view>
        <text class="query-copy" wx:if="{{activeQuery}}">搜索“{{activeQuery}}”</text>
        <view wx:if="{{loading}}" class="category-state"><text>正在寻找好物…</text></view>
        <view wx:elif="{{error && !items.length}}" class="category-state mall-surface" role="alert">
          <text class="state-title">暂时无法加载</text><text class="state-copy">{{error}}</text>
          <button class="mall-primary-action retry" bindtap="onRetry">重新加载</button>
        </view>
        <view wx:elif="{{!items.length}}" class="category-state mall-surface">
          <text class="state-title">{{activeQuery ? '未找到相关商品' : '好物即将上架'}}</text>
          <text class="state-copy">{{activeQuery ? '试试其他关键词，或清除搜索。' : '这个分类正在准备好物，也可以先看看其他分类。'}}</text>
        </view>
        <view wx:else>
          <view class="product-row mall-surface" wx:for="{{items}}" wx:key="product_public_id" data-id="{{item.product_public_id}}" bindtap="onProductTap" role="button" aria-label="查看{{item.name}}">
            <image wx:if="{{item.imageUrl}}" class="product-photo" src="{{item.imageUrl}}" mode="aspectFill" lazy-load="true" data-id="{{item.product_public_id}}" data-src="{{item.imageUrl}}" binderror="onImageError" />
            <view wx:else class="product-photo photo-empty">暂无图片</view>
            <view class="product-info">
              <text class="product-name">{{item.name}}</text><text wx:if="{{item.subtitle}}" class="product-copy">{{item.subtitle}}</text>
              <text class="product-price mall-points">{{item.min_points_price}}<text class="price-unit"> 积分起</text></text>
              <view class="product-actions"><text class="stock {{item.in_stock ? '' : 'sold-out'}}">{{item.in_stock ? '有货' : '暂时无货'}}</text><text class="choose-link">{{item.in_stock ? '选规格 ›' : '查看 ›'}}</text></view>
            </view>
          </view>
          <view wx:if="{{error}}" class="more-state"><text>{{error}}</text><button class="retry mall-primary-action" bindtap="onLoadMore">重试加载更多</button></view>
          <button wx:elif="{{hasMore}}" class="more-action" loading="{{moreLoading}}" disabled="{{moreLoading}}" bindtap="onLoadMore">查看更多好物</button>
          <text wx:else class="page-end">已经看到全部商品</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
<template is="mall-nav" data="{{current: 'categories'}}" />
