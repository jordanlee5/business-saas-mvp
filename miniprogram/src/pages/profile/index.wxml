<import src="../../templates/mall-nav.wxml" />
<view class="screen mall-screen">
  <view class="hero mall-surface">
    <view class="avatar">{{signedIn ? '会' : '访'}}</view>
    <view class="identity">
      <text class="identity-title">{{signedIn ? '会员已登录' : '访客模式'}}</text>
      <text wx:if="{{signedIn}}" class="identity-copy mall-muted">会员编号：{{memberPublicId}}</text>
      <text wx:else class="identity-copy mall-muted">尚未验证会员身份</text>
    </view>
  </view>
  <view class="notice mall-surface">
    <text class="notice-title">{{signedIn ? '身份验证完成' : '会员身份验证'}}</text>
    <text wx:if="{{signedIn}}" class="notice-copy mall-muted">{{qualificationMessage || '正在核验商城资格…'}}</text>
    <text wx:else class="notice-copy mall-muted">已有绑定的会员可主动使用微信登录。持有上传方安全交付的激活码时，可先领取积分权益。</text>
    <text wx:if="{{loading}}" class="notice-copy mall-muted">正在验证会员身份…</text>
    <text wx:if="{{error}}" class="notice-copy error" role="alert">{{error}}</text>
    <button wx:if="{{!signedIn}}" class="mall-primary-action login-action" bindtap="onLoginTap" loading="{{signingIn}}" disabled="{{signingIn || loading}}">{{signingIn ? '正在验证…' : '微信登录'}}</button>
    <button wx:else class="clear-action" bindtap="onClearSessionTap">清除本机登录</button>
  </view>
  <view class="actions mall-surface">
    <button class="action" bindtap="onPointsTap">我的积分<text class="arrow">›</text></button>
    <button class="action" bindtap="onActivationTap">{{signedIn ? '继续领取积分权益' : '激活积分权益'}}<text class="arrow">›</text></button>
    <button class="action" bindtap="onOrdersTap">我的订单<text class="arrow">›</text></button>
    <button class="action" bindtap="onAddressesTap">我的收货地址<text class="arrow">›</text></button>
    <button class="action" bindtap="onPrivacyTap">微信隐私保护指引<text class="arrow">›</text></button>
    <button class="action" bindtap="onRightsTap">会员权益申请<text class="arrow">›</text></button>
    <button class="action" bindtap="onCatalogTap">返回积分商城<text class="arrow">›</text></button>
  </view>
</view>
<view wx:if="{{privacyVisible}}" class="privacy-backdrop">
  <view class="privacy-panel mall-surface" role="dialog" aria-label="微信隐私授权">
    <text class="notice-title">使用会员服务前</text>
    <text class="notice-copy mall-muted">请先阅读并同意微信平台的 {{privacyContractName}}。商城商品仅向具有有效资格的会员展示；你可以暂不使用会员服务。</text>
    <text wx:if="{{privacyError}}" class="notice-copy error" role="alert">{{privacyError}}</text>
    <button class="privacy-link" bindtap="onPrivacyTap">查看完整指引</button>
    <button id="profile-privacy-agree" class="mall-primary-action login-action" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onPrivacyAgree">同意并继续登录</button>
    <button class="clear-action" bindtap="onPrivacyDecline">暂不使用会员服务</button>
  </view>
</view>
<template is="mall-nav" data="{{current: 'profile'}}" />
