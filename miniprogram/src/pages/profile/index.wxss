.hero { display: flex; align-items: center; gap: 24rpx; padding: 38rpx 32rpx; background: linear-gradient(120deg, #e8f0e5, #f8f7ee); }
.avatar { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 100rpx; height: 100rpx; border-radius: 50%; background: #e3eee6; color: #286149; font-size: 37rpx; }
.identity { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 9rpx; }
.identity-title { font-size: 34rpx; font-weight: 600; }
.identity-copy { font-size: 23rpx; line-height: 1.6; overflow-wrap: anywhere; }
.notice { margin-top: 24rpx; padding: 38rpx 34rpx; }
.notice-title { display: block; font-size: 29rpx; font-weight: 600; }
.notice-copy { display: block; margin-top: 15rpx; font-size: 24rpx; line-height: 1.7; }
.actions { margin-top: 24rpx; padding: 0 26rpx; }
.action { display: flex; align-items: center; justify-content: space-between; width: 100%; height: 104rpx; padding: 0 8rpx; border-radius: 0; background: transparent; color: #19322e; font-size: 27rpx; text-align: left; }
.action + .action { border-top: 1rpx solid #edf1ed; }
.arrow { color: #81958a; font-size: 38rpx; }
.login-action { margin-top: 28rpx; font-size: 25rpx; }
.clear-action { margin-top: 18rpx; background: transparent; color: #5d746c; font-size: 24rpx; }
.error { color: #aa4033; }
.privacy-backdrop { position: fixed; z-index: 30; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 30rpx; background: rgba(10, 27, 24, .67); }
.privacy-panel { box-sizing: border-box; width: 100%; max-width: 650rpx; padding: 38rpx 34rpx; }
.privacy-link { margin-top: 20rpx; background: transparent; color: #315e54; font-size: 24rpx; }
