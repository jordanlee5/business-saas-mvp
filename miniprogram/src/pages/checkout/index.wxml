<view class="screen"><view class="heading">确认兑换</view>
<text wx:if="{{error}}" class="copy error" role="alert">{{error}}</text>
<text wx:if="{{loading}}" class="copy">正在核对…</text>
<view wx:elif="{{complete}}" class="card mall-surface"><text class="copy">订单已提交：{{complete}}</text><button bindtap="onOrders">查看我的订单</button></view>
<view wx:elif="{{pending}}" class="card mall-surface"><text class="copy">上次提交结果待确认，请先查询。重新核对仍会恢复本次兑换，避免重复下单。</text><button bindtap="onQuery" disabled="{{busy}}">查询提交结果</button><button wx:if="{{canRetry}}" bindtap="onSubmit" disabled="{{busy}}">重试同一订单</button><button bindtap="onReviewPending" disabled="{{busy}}">重新核对同一订单</button><button bindtap="onOrders">查看我的订单</button></view>
<block wx:elif="{{owner}}">
<view class="card mall-surface"><text class="title">选择收货地址</text><button wx:for="{{addresses}}" wx:key="address_public_id" data-id="{{item.address_public_id}}" bindtap="onSelect" disabled="{{busy}}" class="address {{selected === item.address_public_id ? 'selected' : ''}}"><text>{{selected === item.address_public_id ? '✓ ' : ''}}{{item.recipient_name}} {{item.phone}}</text><text class="copy">{{item.province}} {{item.city}} {{item.district}} {{item.detail}}</text></button><text wx:if="{{!addresses.length}}" class="copy">请先添加收货地址。</text><button bindtap="onAddresses" disabled="{{busy}}">管理收货地址</button></view>
<view class="card mall-surface"><view wx:for="{{items}}" wx:key="key" class="copy">{{item.product_name}} · {{item.sku_name}} × {{item.quantity}}<text class="copy">{{item.line_points}} 积分</text></view><text class="title">合计 {{total}} 积分 · 包邮</text><text class="copy">提交后预占积分和库存，后台确认履约后消费积分。待处理订单可在我的订单中取消。</text></view>
<view wx:if="{{fulfillment}}" class="card mall-surface"><text class="title">兑换与发货服务</text><text class="copy">{{fulfillment.operator_name}}</text><text class="copy">{{fulfillment.notice}}</text><text class="copy">公司客服：{{fulfillment.operator_contact}}</text><view wx:for="{{fulfillment.suppliers}}" wx:key="supplier_public_id" class="copy"><text class="title">受托发货：{{item.name}}</text><text class="copy">公司客服：{{item.contact}}</text><text wx:for="{{item.items}}" wx:for-item="goods" wx:key="sku_code" class="copy">{{goods.product_name}} · {{goods.sku_name}} × {{goods.quantity}}</text></view><text wx:if="{{!fulfillment.ready}}" class="copy error">{{fulfillment.message}}</text></view><button class="mall-primary-action" bindtap="onSubmit" loading="{{busy}}" disabled="{{busy || !selected || !items.length || !fulfillment.ready}}">确认提交兑换</button><button bindtap="onReload" disabled="{{busy}}">重新核对</button>
</block><button wx:else bindtap="onProfile">前往会员登录</button></view>
