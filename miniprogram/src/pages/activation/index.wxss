.screen { padding: 30rpx 28rpx 80rpx; }
.intro, .form, .result { padding: 38rpx 34rpx; }
.form, .result { margin-top: 24rpx; }
.heading { display: block; font-size: 34rpx; font-weight: 600; }
.copy, .hint { display: block; margin-top: 16rpx; font-size: 24rpx; line-height: 1.6; }
.label { display: block; margin-top: 28rpx; color: #19322e; font-size: 25rpx; }
.field { box-sizing: border-box; width: 100%; height: 86rpx; margin-top: 12rpx; padding: 0 20rpx; border: 1rpx solid #dce6df; border-radius: 14rpx; background: #fbfcfb; font-size: 27rpx; }
.action { margin-top: 34rpx; font-size: 27rpx; }
.error { display: block; margin-top: 20rpx; color: #aa4033; font-size: 24rpx; line-height: 1.5; }
