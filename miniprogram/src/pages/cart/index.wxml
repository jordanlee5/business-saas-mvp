<import src="../../templates/mall-nav.wxml" />
<view class="screen mall-screen">
  <view class="intro mall-surface">
    <text class="eyebrow">MY CART / 购物车</text>
    <text class="title">把喜欢的，先留下。</text>
    <text class="intro-copy mall-muted">挑选的好物保存在这台设备上，随时回来看看。</text>
  </view>
  <view class="state mall-surface" wx:if="{{loading}}" role="status">
    <text class="state-title">正在核对好物</text>
    <text class="state-copy mall-muted">为你更新商品积分价与库存状态…</text>
  </view>
  <view class="state mall-surface" wx:elif="{{error}}" role="alert">
    <text class="state-title">购物车暂时无法加载</text>
    <text class="state-copy mall-muted">{{error}}</text>
    <button class="mall-primary-action state-action" bindtap="onRetry">重新加载</button>
  </view>
  <view class="state mall-surface" wx:elif="{{!items.length}}">
    <view class="mall-empty-mark" aria-hidden="true"><view class="mall-nav-icon mall-icon-cart"></view></view>
    <text class="state-title">购物车还是空的</text>
    <text class="state-copy mall-muted">去发现喜欢的好物，选好规格再加入这里。</text>
    <button class="mall-primary-action state-action" bindtap="onCatalogTap">去逛好物</button>
  </view>
  <view wx:else>
    <view class="list-heading"><text>已选好物</text><text class="list-count">共 {{items.length}} 款规格</text></view>
    <view class="item mall-surface" wx:for="{{items}}" wx:key="key">
      <view class="item-heading">
        <text class="product" data-id="{{item.product_public_id}}" bindtap="onProductTap">{{item.product_name}}</text>
        <text class="status {{item.available ? 'available' : 'unavailable'}}">{{item.status}}</text>
      </view>
      <text class="sku mall-muted">{{item.sku_name}}</text>
      <text class="price mall-points" wx:if="{{item.points_price}}">{{item.points_price}} <text class="price-unit">积分 / 件</text></text>
      <view class="controls">
        <view class="stepper">
          <button data-id="{{item.product_public_id}}" data-sku="{{item.sku_code}}" bindtap="onDecrease"
                  aria-label="减少数量" disabled="{{item.quantity <= 1}}">－</button>
          <text class="quantity" aria-label="数量">{{item.quantity}}</text>
          <button data-id="{{item.product_public_id}}" data-sku="{{item.sku_code}}" bindtap="onIncrease"
                  aria-label="增加数量" disabled="{{item.quantity >= 99 || !item.available}}">＋</button>
        </view>
        <button class="remove" data-id="{{item.product_public_id}}" data-sku="{{item.sku_code}}" bindtap="onRemove">移除</button>
      </view>
      <text class="line-points" wx:if="{{item.available}}">小计 <text class="mall-points">{{item.line_points}} 积分</text></text>
    </view>
    <text class="action-error" wx:if="{{actionError}}" role="alert">{{actionError}}</text>
    <view class="summary mall-surface">
      <text class="summary-label">可用商品参考合计</text>
      <text class="summary-total mall-points">{{estimate}} <text class="price-unit">积分</text></text>
      <text class="summary-note mall-muted" wx:if="{{hasUnavailable}}">下架、无货或不可见的规格未计入合计。</text>
      <text class="summary-note mall-muted">价格和库存会更新，下拉可刷新。当前仅支持整理购物车，订单提交尚未开放。</text>
    </view>
  </view>
</view>
<template is="mall-nav" data="{{current: 'cart'}}" />
