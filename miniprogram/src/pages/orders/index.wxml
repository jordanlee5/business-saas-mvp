<import src="../../templates/delivery-info.wxml" />
<view class="screen">
  <view class="heading">{{detailMode ? '订单详情' : '我的订单'}}</view>
  <text wx:if="{{error}}" class="copy error" role="alert">{{error}}</text>
  <button wx:if="{{!hasSession}}" bindtap="onProfile">登录后查看订单</button>
  <text wx:elif="{{loading}}" class="copy">正在读取…</text>
  <block wx:elif="{{detail}}">
    <view class="card mall-surface">
      <text wx:if="{{submitted && detail.status === 'CREATED'}}" class="badge">订单提交成功</text>
      <text class="title">{{labels[detail.status]}}</text>
      <text class="copy">{{detail.order_public_id}}</text>
      <view wx:for="{{detail.items}}" wx:key="index" class="copy">{{item.product_name}} · {{item.sku_name}} × {{item.quantity}} · {{item.line_points}} 积分</view>
      <text class="title">合计 {{detail.total_points}} 积分</text>
      <text wx:if="{{cartWarning}}" class="copy error">订单已成功，请手动核对购物车。</text>
    </view>
    <view class="card mall-surface">
      <text class="title">收货信息</text>
      <text wx:if="{{detail.address}}" class="copy">{{detail.address.recipient_name}} {{detail.address.phone}}
{{detail.address.province}} {{detail.address.city}} {{detail.address.district}} {{detail.address.detail}}</text>
      <text wx:elif="{{detail.address_state === 'CLEARED'}}" class="copy">收货信息已按保存规则清理，订单交易记录仍保留。</text>
      <text wx:else class="copy">历史订单未保存收货信息</text>
      <text wx:if="{{detail.tracking_number}}" class="copy">{{detail.shipping_carrier}} · {{detail.tracking_number}}</text>
    </view>
    <template is="delivery-info" data="{{noticeExpanded, serviceContact: detail.fulfillment ? detail.fulfillment.operator_contact : ''}}" />
    <button wx:if="{{detail.status === 'CREATED' && !confirmCancel}}" bindtap="onCancel" disabled="{{busy}}">取消订单</button>
    <view wx:if="{{confirmCancel}}" class="card mall-surface">
      <text class="copy">确认取消？取消后，本单使用的积分将退回。</text>
      <button bindtap="onConfirmCancel" disabled="{{busy}}" loading="{{busy}}">确认取消</button>
      <button bindtap="onKeep" disabled="{{busy}}">保留订单</button>
    </view>
  </block>
  <block wx:elif="{{!detailMode}}">
    <text wx:if="{{hasSession && !items.length && !error}}" class="copy">暂无订单</text>
    <view wx:for="{{items}}" wx:key="order_public_id" class="card mall-surface">
      <text class="title">{{labels[item.status]}} · {{item.total_points}} 积分</text>
      <text class="copy">{{item.order_public_id}}</text><text class="copy">下单时间：{{item.createdText}}（北京时间）</text>
      <button data-id="{{item.order_public_id}}" bindtap="onDetail">查看详情</button>
    </view>
    <view wx:if="{{hasSession}}"><button bindtap="onPrevious" disabled="{{page <= 1 || loading}}">上一页</button><text class="copy">第 {{page}} 页 · 共 {{total}} 单</text><button bindtap="onNext" disabled="{{page * 20 >= total || loading}}">下一页</button></view>
  </block>
  <button wx:if="{{detailMode}}" bindtap="onBack" disabled="{{busy || loading}}">查看全部订单</button>
  <button wx:if="{{hasSession}}" bindtap="onReload" disabled="{{loading || busy}}">{{detailMode ? '刷新本单' : '刷新订单'}}</button>
  <button class="mall-primary-action" bindtap="onCatalog" disabled="{{busy}}">继续逛好物</button>
</view>
