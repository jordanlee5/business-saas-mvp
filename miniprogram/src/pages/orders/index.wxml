<view class="screen"><view class="heading">我的订单</view><text wx:if="{{error}}" class="copy error" role="alert">{{error}}</text><button wx:if="{{!hasSession}}" bindtap="onProfile">登录后查看订单</button><text wx:elif="{{loading}}" class="copy">正在读取…</text><block wx:elif="{{detail}}"><view class="card mall-surface"><text class="title">{{labels[detail.status]}}</text><text class="copy">{{detail.order_public_id}}</text><view wx:for="{{detail.items}}" wx:key="index" class="copy">{{item.product_name}} · {{item.sku_name}} × {{item.quantity}} · {{item.line_points}} 积分</view><text class="title">合计 {{detail.total_points}} 积分</text></view><view class="card mall-surface"><text class="title">下单时收货地址</text><text wx:if="{{detail.address}}" class="copy">{{detail.address.recipient_name}} {{detail.address.phone}}
{{detail.address.province}} {{detail.address.city}} {{detail.address.district}} {{detail.address.detail}}</text><text wx:else class="copy">历史订单未保存收货快照</text><text wx:if="{{detail.tracking_number}}" class="copy">{{detail.shipping_carrier}} · {{detail.tracking_number}}</text></view><button wx:if="{{detail.status === 'CREATED' && !confirmCancel}}" bindtap="onCancel" disabled="{{busy}}">取消订单</button><view wx:if="{{confirmCancel}}" class="card mall-surface"><text class="copy">确认取消？将按订单原预占记录释放积分和库存。</text><button bindtap="onConfirmCancel" disabled="{{busy}}" loading="{{busy}}">确认取消</button><button bindtap="onKeep" disabled="{{busy}}">保留订单</button></view><button bindtap="onBack" disabled="{{busy}}">返回订单列表</button></block><block wx:else><text wx:if="{{hasSession && !items.length && !error}}" class="copy">暂无订单</text><view wx:for="{{items}}" wx:key="order_public_id" class="card mall-surface"><text class="title">{{labels[item.status]}} · {{item.total_points}} 积分</text><text class="copy">{{item.order_public_id}}</text><text class="copy">{{item.created_at}}</text><button data-id="{{item.order_public_id}}" bindtap="onDetail">查看详情</button></view><view wx:if="{{hasSession}}"><button bindtap="onPrevious" disabled="{{page <= 1 || loading}}">上一页</button><text class="copy">第 {{page}} 页 · 共 {{total}} 单</text><button bindtap="onNext" disabled="{{page * 20 >= total || loading}}">下一页</button></view></block><button wx:if="{{hasSession}}" bindtap="onReload" disabled="{{loading || busy}}">刷新订单</button></view>
