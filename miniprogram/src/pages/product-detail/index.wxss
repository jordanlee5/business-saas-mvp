.screen { padding: 24rpx 24rpx 76rpx; }
.gallery { width: 100%; height: 600rpx; border-radius: 26rpx; overflow: hidden; background: #e5ede7; }
.gallery-photo { width: 100%; height: 100%; }
.gallery-empty { display: flex; align-items: center; justify-content: center; color: #87a18e; letter-spacing: 4rpx; }
.card { padding: 32rpx; margin-top: 22rpx; }
.heading { display: flex; flex-direction: column; }
.eyebrow { color: #608579; font-size: 20rpx; letter-spacing: 2rpx; }
.name { font-size: 40rpx; font-weight: 600; line-height: 1.45; margin-top: 18rpx; }
.subtitle { color: #758a80; font-size: 26rpx; margin-top: 10rpx; }
.price-row { display: flex; justify-content: space-between; align-items: baseline; margin-top: 30rpx; }
.price { font-size: 40rpx; }
.unit { font-size: 22rpx; font-weight: 400; }
.stock, .sku-stock { font-size: 22rpx; }
.available { color: #206f53; }
.low { color: #a46827; }
.out { color: #9baba5; }
.section-title { display: block; font-size: 32rpx; font-weight: 600; margin-bottom: 20rpx; }
.sku-note { display: block; color: #758a80; font-size: 23rpx; margin-bottom: 16rpx; }
.sku { display: flex; justify-content: space-between; align-items: center; width: 100%; text-align: left; padding: 22rpx; margin: 12rpx 0 0; background: #f7faf8; border: 2rpx solid #e4ebe6; border-radius: 18rpx; box-sizing: border-box; gap: 16rpx; line-height: 1.4; }
.sku::after { border: 0; }
.sku-selected { background: #edf7f1; border-color: #206f53; }
.sku-info { display: flex; flex-direction: column; gap: 10rpx; }
.sku-name { font-size: 27rpx; }
.sku-end { display: flex; flex-direction: column; align-items: flex-end; gap: 10rpx; }
.sku-price { font-size: 27rpx; white-space: nowrap; }
.sku-check { color: #206f53; font-size: 22rpx; }
.description { display: block; white-space: pre-wrap; line-height: 1.7; color: #546b60; font-size: 26rpx; }
.detail-photo { width: 100%; margin-top: 18rpx; border-radius: 12rpx; }
.footer-note { font-size: 22rpx; text-align: center; padding: 38rpx 0; }
.state { min-height: 430rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 36rpx; text-align: center; }
.state-title { font-size: 31rpx; font-weight: 600; }
.state-copy { font-size: 24rpx; margin-top: 16rpx; }
.action { font-size: 25rpx; margin-top: 30rpx; }
.skeleton-photo { height: 570rpx; background: #e5ede7; border-radius: 24rpx; }
.skeleton-line { width: 85%; height: 42rpx; background: #e5ede7; border-radius: 12rpx; margin-top: 32rpx; }
.skeleton-line.short { width: 52%; }
