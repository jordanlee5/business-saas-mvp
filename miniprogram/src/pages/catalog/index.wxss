.hero { background: #153d39; color: #fff; border-radius: 30rpx; padding: 38rpx 34rpx; min-height: 222rpx; background: linear-gradient(120deg, #153d39, #2d5945); display: flex; flex-direction: column; justify-content: space-between; }
.eyebrow { color: #bddfc6; font-size: 20rpx; letter-spacing: 3rpx; }
.headline { font-size: 42rpx; font-weight: 600; line-height: 1.42; margin-top: 22rpx; }
.headline-second { margin-top: 0; }
.hero-note { color: #cce4d3; font-size: 23rpx; margin-top: 25rpx; }
.search-area { display: flex; align-items: center; gap: 14rpx; margin-top: 28rpx; }
.search-field { display: flex; align-items: center; flex: 1; min-width: 0; height: 82rpx; border-radius: 42rpx; background: #fff; padding: 0 24rpx; }
.search-mark { color: #5d7870; font-size: 38rpx; margin-right: 10rpx; }
.search-input { flex: 1; min-width: 0; color: #19322e; font-size: 27rpx; }
.search-clear { padding: 15rpx 0 15rpx 18rpx; color: #5a756b; font-size: 24rpx; }
.search-button { flex-shrink: 0; margin: 0; padding: 0 32rpx; height: 82rpx; line-height: 82rpx; border-radius: 42rpx; background: #153d39; color: #fff; font-size: 26rpx; }
.search-hint { display: block; margin: 14rpx 10rpx 0; color: #a34334; font-size: 23rpx; }
.query-heading { color: #53746c; font-size: 24rpx; margin-top: 25rpx; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; margin: 36rpx 0 22rpx; }
.section-title { font-size: 34rpx; font-weight: 600; }
.section-note { color: #68796e; font-size: 21rpx; }
.tabs { white-space: nowrap; margin-bottom: 30rpx; }
.tabs-inner { display: flex; gap: 16rpx; }
.tab { display: inline-flex; flex-shrink: 0; border-radius: 36rpx; padding: 17rpx 30rpx; background: #fff; color: #49615b; font-size: 25rpx; }
.tab-active { background: #153d39; color: #fff; }
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.card { width: 48%; margin-bottom: 20rpx; overflow: hidden; box-shadow: 0 10rpx 26rpx rgba(27, 58, 50, .04); }
.photo { display: flex; align-items: center; justify-content: center; width: 100%; height: 290rpx; background: #e1ece5; }
.photo-empty { color: #87a18e; font-size: 24rpx; letter-spacing: 3rpx; }
.card-body { min-height: 135rpx; padding: 22rpx; display: flex; flex-direction: column; }
.name { font-size: 28rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.subtitle { color: #81928c; font-size: 22rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 9rpx; }
.card-footer { display: flex; align-items: baseline; justify-content: space-between; gap: 6rpx; margin-top: auto; padding-top: 18rpx; }
.price { font-size: 30rpx; }
.unit { font-size: 19rpx; font-weight: 400; }
.stock { color: #206f53; font-size: 20rpx; white-space: nowrap; }
.sold-out { color: #9baba5; }
.state { min-height: 350rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 30rpx; text-align: center; }
.state-small { min-height: 140rpx; margin-top: 20rpx; }
.state-title { font-size: 31rpx; font-weight: 600; }
.state-copy { font-size: 24rpx; margin-top: 14rpx; line-height: 1.7; }
.retry, .load-more { font-size: 25rpx; margin-top: 28rpx; }
.load-more { margin: 32rpx 10rpx; }
.page-end { text-align: center; font-size: 22rpx; padding: 35rpx; }
.skeleton { display: flex; gap: 20rpx; }
.skeleton-card { flex: 1; height: 410rpx; border-radius: 23rpx; background: #e8eee9; }
