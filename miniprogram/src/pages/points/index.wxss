.intro { padding: 36rpx 32rpx; background: linear-gradient(120deg, #e8f0e5, #f8f7ee); }
.eyebrow { display: block; color: #38735b; font-size: 21rpx; letter-spacing: 2rpx; }
.title { display: block; margin-top: 18rpx; color: #19322e; font-size: 38rpx; font-weight: 600; }
.copy { display: block; margin-top: 18rpx; color: #5d746c; font-size: 25rpx; line-height: 1.65; }
.guest-card { margin-top: 24rpx; padding: 34rpx 32rpx; }
.card-title { display: block; font-size: 32rpx; font-weight: 600; }
.card-copy { display: block; margin-top: 16rpx; font-size: 24rpx; line-height: 1.65; }
.action { margin: 36rpx 0 0; font-size: 26rpx; }
.back-link { margin-top: 28rpx; background: transparent; color: #23664f; font-size: 25rpx; }
.balance { display: block; margin: 12rpx 0 20rpx; color: #153d39; font-size: 58rpx; font-weight: 600; overflow-wrap: anywhere; }
.expiry-note { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #edf1ed; }
.expiry-title { display: block; color: #19322e; font-size: 25rpx; font-weight: 600; }
.expiry-copy { display: block; margin-top: 10rpx; color: #5d746c; font-size: 23rpx; line-height: 1.65; }
.ledger-section { margin-top: 24rpx; padding: 36rpx 32rpx; }
.ledger-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.ledger-total { color: #5d746c; font-size: 23rpx; }
.ledger-item { margin-top: 24rpx; padding: 26rpx 22rpx; border: 1rpx solid #e5ede8; border-radius: 18rpx; background: #f9fbf9; }
.ledger-title { color: #193d35; font-size: 27rpx; font-weight: 600; }
.ledger-amount { font-size: 30rpx; font-weight: 600; overflow-wrap: anywhere; }
.incoming { color: #23664f; }
.outgoing { color: #a96318; }
.amount-unit { margin-left: 8rpx; font-size: 21rpx; font-weight: 400; }
.ledger-date { display: block; margin-top: 14rpx; color: #5d746c; font-size: 21rpx; }
.more-action { margin-top: 28rpx; color: #23664f; background: #f0f6f2; font-size: 25rpx; }
