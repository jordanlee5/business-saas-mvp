.intro { padding: 36rpx 32rpx; background: linear-gradient(120deg, #e8f0e5, #f8f7ee); }
.eyebrow { display: block; color: #38735b; font-size: 21rpx; letter-spacing: 2rpx; }
.title { display: block; margin-top: 18rpx; color: #19322e; font-size: 38rpx; font-weight: 600; }
.copy { display: block; margin-top: 18rpx; color: #5d746c; font-size: 25rpx; line-height: 1.65; }
.guest-card { margin-top: 24rpx; padding: 34rpx 32rpx; }
.card-title { display: block; font-size: 32rpx; font-weight: 600; }
.card-copy { display: block; margin-top: 16rpx; font-size: 24rpx; line-height: 1.65; }
.action { margin: 36rpx 0 0; font-size: 26rpx; }
.back-link { margin-top: 28rpx; background: transparent; color: #23664f; font-size: 25rpx; }
.balance { display: block; margin: 12rpx 0 28rpx; color: #153d39; font-size: 58rpx; font-weight: 600; }
.summary-row { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; padding: 20rpx 0; border-top: 1rpx solid #edf1ed; color: #5d746c; font-size: 24rpx; }
.summary-row text:last-child { color: #19322e; text-align: right; }
.grant-section { margin-top: 24rpx; padding: 36rpx 34rpx; }
.grant-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.grant-total { color: #5d746c; font-size: 23rpx; }
.grant-item { margin-top: 26rpx; padding: 26rpx 22rpx; border: 1rpx solid #e5ede8; border-radius: 18rpx; background: #f9fbf9; }
.grant-amount { color: #193d35; font-size: 27rpx; font-weight: 600; }
.grant-status { color: #23664f; font-size: 22rpx; flex-shrink: 0; }
.grant-item .summary-row { padding: 14rpx 0; }
.grant-item .summary-row:first-of-type { margin-top: 16rpx; }
.grant-date { display: block; color: #5d746c; font-size: 21rpx; line-height: 1.55; overflow-wrap: anywhere; }
.more-action { margin-top: 28rpx; color: #23664f; background: #f0f6f2; font-size: 25rpx; }
.ledger-section { margin-top: 24rpx; padding: 36rpx 34rpx; }
.ledger-item { margin-top: 26rpx; padding: 26rpx 22rpx; border: 1rpx solid #e5ede8; border-radius: 18rpx; background: #f9fbf9; }
.ledger-item .summary-row { padding: 14rpx 0; }
.ledger-date { color: #5d746c; font-size: 21rpx; text-align: right; overflow-wrap: anywhere; }
