<view class="screen">
  <view class="intro mall-surface">
    <text class="eyebrow">MY POINTS / 我的积分</text>
    <text class="title">{{signedIn ? '每一分，都有来处。' : '你的积分，等你开启。'}}</text>
    <text class="copy" wx:if="{{signedIn}}">会员编号：{{memberPublicId}}</text>
    <text class="copy" wx:else>完成微信身份绑定与权益激活后，才能安全查看属于你的积分。</text>
  </view>
  <view wx:if="{{loading}}" class="guest-card mall-surface" role="status">
    <text class="card-title">正在读取积分</text>
    <text class="card-copy mall-muted">正在确认当前会员身份与积分账户…</text>
  </view>
  <view wx:elif="{{signedIn}}" class="guest-card mall-surface">
    <text class="card-title">可用积分</text>
    <text class="balance">{{availablePoints}}</text>
    <view class="summary-row"><text>已预占积分</text><text>{{reservedPoints}}</text></view>
    <view class="summary-row"><text>积分批次数</text><text>{{grantCount}}</text></view>
    <view class="summary-row"><text>最近到期</text><text>{{nearestExpiry || '暂无'}}</text></view>
    <text class="card-copy mall-muted">积分批次明细与权益激活将在后续阶段接入。</text>
  </view>
  <view wx:elif="{{error}}" class="guest-card mall-surface" role="alert">
    <text class="card-title">暂时无法读取积分</text>
    <text class="card-copy mall-muted">{{error}}</text>
    <button wx:if="{{hasSession}}" class="mall-primary-action action" bindtap="onRetryTap">重新加载</button>
    <button wx:else class="mall-primary-action action" bindtap="onProfileTap">前往个人中心</button>
  </view>
  <view wx:else class="guest-card mall-surface">
    <text class="card-title">尚未登录</text>
    <text class="card-copy mall-muted">暂不能展示余额与积分批次。此页不会把访客积分记为 0，也不会请求其他会员的数据。</text>
    <button class="mall-primary-action action" bindtap="onProfileTap">前往个人中心</button>
  </view>
  <button class="back-link" bindtap="onCatalogTap">返回商城选好物</button>
</view>
<view class="mall-nav" aria-label="积分商城导航">
  <button class="mall-nav-item" bindtap="onCatalogTap" aria-label="打开逛好物">逛好物</button>
  <view class="mall-nav-item mall-nav-current" aria-label="当前：我的积分"><text>我的积分</text></view>
  <button class="mall-nav-item" bindtap="onProfileTap" aria-label="打开个人中心">个人中心</button>
</view>
