[Unit]
Description=Verified backup for isolated SaaS staging project %i
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/saas-staging/current
EnvironmentFile=/srv/saas-private/backup-%i.env
ExecStart=/usr/bin/python3 -m tools.staging_backup_job --project %i --root /srv/saas-backups/scheduled/%i
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Do not kill pg_dump/stop-and-copy midway; monitor duration separately.
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal
